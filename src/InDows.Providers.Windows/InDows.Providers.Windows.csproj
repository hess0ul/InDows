<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Description>Windows access for InDows: machine context, and later disk and media work.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InDows.Core\InDows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the secrets vault: a standard WinZip AES-256 zip, the same format ReDows writes. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>

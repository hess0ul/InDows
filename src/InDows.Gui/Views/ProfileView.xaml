<UserControl x:Class="InDows.Gui.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Profile" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource App.Muted}" Margin="0,4,0,18"
                       Text="The apps and settings a ReDows export brings back. Point at the profile folder to see what is inside."/>

            <!-- Profile folder -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ProfileFolder, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}"/>
            </Grid>

            <!-- Error -->
            <Border Background="#3A2A2A" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Error}" Foreground="#FF9B9B"/>
            </Border>

            <!-- Summary -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Apps -->
                <TextBlock Text="Apps to reinstall" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Summary.ActiveApps}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource App.Card}" CornerRadius="6" Padding="12,7" Margin="0,0,0,5"
                                    BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                                <TextBlock Text="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Foreground="{StaticResource App.Muted}" FontSize="12" Margin="0,0,0,18">
                    <Run Text="{Binding Summary.CommentedApps, Mode=OneWay}"/><Run Text=" more commented out (no reliable winget id)."/>
                </TextBlock>

                <!-- Settings -->
                <TextBlock Text="Settings" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Summary.Buckets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource App.Card}" CornerRadius="6" Padding="14,10" Margin="0,0,0,7"
                                    BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource App.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Run Text="{Binding SettingCount, Mode=OneWay}"/><Run Text=" setting(s)"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Modules}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource App.Surface}" CornerRadius="4" Padding="7,2" Margin="0,0,5,5"
                                                        BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                                                    <TextBlock Text="{Binding}" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

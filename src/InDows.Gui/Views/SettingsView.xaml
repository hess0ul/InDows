<UserControl x:Class="InDows.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource App.Muted}" Margin="0,4,0,18"
                       Text="App preferences, kept in %LocalAppData%\InDows."/>

            <!-- Default output folder -->
            <TextBlock Text="Default output folder" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock Foreground="{StaticResource App.Muted}" FontSize="12" Margin="0,0,0,6"
                       Text="Where the Save dialog opens when you save a generated autounattend.xml."/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource App.Surface}" CornerRadius="6"
                        BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                    <TextBox Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource App.Text}"
                             VerticalContentAlignment="Center" Padding="8,6"/>
                </Border>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Command="{Binding BrowseOutputCommand}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="Save" Style="{StaticResource GhostButton}"
                        Background="{StaticResource App.Accent}" Foreground="#0B0E11" FontWeight="SemiBold"
                        Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource App.Good}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- About -->
            <Border Background="{StaticResource App.Card}" CornerRadius="8" Padding="16,14"
                    BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="{Binding Version, StringFormat=' v{0}'}" Foreground="{StaticResource App.Muted}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource App.Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Declare your Windows 11 once — install it on autopilot. The after-reset companion to ReDows."/>
                    <TextBlock>
                        <Hyperlink NavigateUri="{Binding RepoUrl}" RequestNavigate="OnRequestNavigate"
                                   Foreground="{StaticResource App.Accent}" TextDecorations="None">
                            <Run Text="{Binding RepoUrl, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

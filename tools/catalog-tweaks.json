  "_comment_security": "The BitLocker default is the safe active line; the rest are the 'danger zone' lines, commented in the source and only uncommented when ticked (AssembleScript forces each selected line active). Content must match the source line's code exactly.",
  "security": [
    { "id": "bitlocker-auto-off", "label": "Prevent automatic BitLocker encryption", "risk": "safe", "default": true,
      "content": "RegDword 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\BitLocker' 'PreventDeviceEncryption' 1" },
    { "id": "uac-no-prompt", "label": "UAC: never show the admin consent prompt", "risk": "risky", "default": false,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' 'ConsentPromptBehaviorAdmin' 0" },
    { "id": "uac-disable", "label": "UAC: fully disable (nuclear)", "risk": "risky", "default": false,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' 'EnableLUA' 0" },
    { "id": "smartscreen-off", "label": "Disable SmartScreen", "risk": "risky", "default": false,
      "content": "RegString 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer' 'SmartScreenEnabled' 'Off'\nRegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System' 'EnableSmartScreen' 0\nRegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge' 'SmartScreenEnabled' 0" },
    { "id": "defender-cloud-off", "label": "Defender: cloud-delivered protection off", "risk": "risky", "default": false,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Spynet' 'SpynetReporting' 0" },
    { "id": "defender-samples-off", "label": "Defender: automatic sample submission off", "risk": "risky", "default": false,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Spynet' 'SubmitSamplesConsent' 2" },
    { "id": "defender-realtime-off", "label": "Defender: real-time monitoring off", "risk": "risky", "default": false,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection' 'DisableRealtimeMonitoring' 1" },
    { "id": "defender-disable", "label": "Defender: disable the whole engine (nuclear)", "risk": "risky", "default": false,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender' 'DisableAntiSpyware' 1" }
  ]
}

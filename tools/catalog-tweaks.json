{
  "_comment": "Individual settings for decomposed modules. Key = module name; each entry = one toggle. 'content' is the exact script fragment the tweak contributes (references the module's own scaffold: $adv, $U, $cdm). Modules absent here stay a single whole-module checkbox until decomposed.",

  "explorer-ui": [
    { "id": "show-file-ext", "label": "Show known file extensions", "risk": "safe", "default": true,
      "content": "RegDword $adv 'HideFileExt' 0" },
    { "id": "show-hidden", "label": "Show hidden files", "risk": "safe", "default": true,
      "content": "RegDword $adv 'Hidden' 1" },
    { "id": "open-this-pc", "label": "Open Explorer to This PC (not Home)", "risk": "safe", "default": true,
      "content": "RegDword $adv 'LaunchTo' 1" },
    { "id": "drive-letters-first", "label": "Show drive letter before the label", "risk": "safe", "default": true,
      "content": "RegDword $adv 'ShowDriveLettersFirst' 4" },
    { "id": "expand-nav-pane", "label": "Auto-expand the nav pane to the open folder", "risk": "safe", "default": true,
      "content": "RegDword $adv 'NavPaneExpandToCurrentFolder' 1" },
    { "id": "hide-gallery", "label": "Hide Gallery in the nav pane", "risk": "safe", "default": true,
      "content": "RegDword \"$U\\Software\\Classes\\CLSID\\{e88865ea-0e1c-4e20-9aa6-edcd0212c87c}\" 'System.IsPinnedToNameSpaceTree' 0" },
    { "id": "compact-mode", "label": "Compact mode (tighter row spacing)", "risk": "safe", "default": false,
      "content": "RegDword $adv 'UseCompactMode' 1" },
    { "id": "show-super-hidden", "label": "Show protected operating-system files", "risk": "advanced", "default": false,
      "content": "RegDword $adv 'ShowSuperHidden' 1" },
    { "id": "hide-home", "label": "Hide Home in the nav pane (leaves This PC)", "risk": "safe", "default": false,
      "content": "RegDword \"$U\\Software\\Classes\\CLSID\\{f874310e-b6b7-47dc-bc84-b9e6b38f5903}\" 'System.IsPinnedToNameSpaceTree' 0" },
    { "id": "show-empty-drives", "label": "Show empty drives", "risk": "safe", "default": true,
      "content": "RegDword $adv 'HideDrivesWithNoMedia' 0" },
    { "id": "full-path-title", "label": "Show the full path in the title bar", "risk": "safe", "default": false,
      "content": "RegDword \"$U\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\CabinetState\" 'FullPath' 1" }
  ],

  "privacy-telemetry": [
    { "id": "activity-history", "label": "Activity history off", "risk": "safe", "default": true,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System' 'PublishUserActivities' 0\nRegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System' 'EnableActivityFeed' 0" },
    { "id": "advertising-id", "label": "Advertising ID off", "risk": "safe", "default": true,
      "content": "RegDword \"$U\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo\" 'Enabled' 0" },
    { "id": "tailored-experiences", "label": "Tailored experiences with diagnostic data off", "risk": "safe", "default": true,
      "content": "RegDword \"$U\\Software\\Microsoft\\Windows\\CurrentVersion\\Privacy\" 'TailoredExperiencesWithDiagnosticDataEnabled' 0" },
    { "id": "suggested-content", "label": "Suggested content, tips & silent OEM app installs off", "risk": "safe", "default": true,
      "content": "$cdm = \"$U\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager\"\nRegDword $cdm 'SystemPaneSuggestionsEnabled' 0\nRegDword $cdm 'SubscribedContent-310093Enabled' 0\nRegDword $cdm 'SubscribedContent-338388Enabled' 0\nRegDword $cdm 'SubscribedContent-338389Enabled' 0\nRegDword $cdm 'SubscribedContent-353694Enabled' 0\nRegDword $cdm 'SubscribedContent-353696Enabled' 0\nRegDword $cdm 'SilentInstalledAppsEnabled' 0\nRegDword $cdm 'PreInstalledAppsEnabled' 0\nRegDword $cdm 'OemPreInstalledAppsEnabled' 0\nRegDword $cdm 'ContentDeliveryAllowed' 0" },
    { "id": "find-my-device", "label": "Find My Device off", "risk": "safe", "default": true,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\FindMyDevice' 'AllowFindMyDevice' 0" },
    { "id": "troubleshooters-off", "label": "Recommended troubleshooters: don't run any", "risk": "safe", "default": true,
      "content": "RegDword 'HKLM:\\SOFTWARE\\Microsoft\\WindowsMitigation' 'UserPreference' 1" },
    { "id": "share-across-devices-off", "label": "Share across devices off (also turns off clipboard sync)", "risk": "safe", "default": false,
      "content": "RegDword \"$U\\Software\\Microsoft\\Windows\\CurrentVersion\\CDP\" 'CdpSessionUserAuthzPolicy' 0\nRegDword \"$U\\Software\\Microsoft\\Windows\\CurrentVersion\\CDP\" 'RomeSdkChannelUserAuthzPolicy' 0" },
    { "id": "resume-off", "label": "Resume (\"continue on this PC\") off", "risk": "safe", "default": true,
      "content": "RegDword \"$U\\Software\\Microsoft\\Windows\\CurrentVersion\\CrossDeviceResume\\Configuration\" 'IsResumeAllowed' 0" }
  ],

